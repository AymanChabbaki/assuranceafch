# ─── Backend Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Port the Express server listens on
PORT=3000

# Sepolia RPC URL (same as blockchain/.env)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Deployed contract address (set after deployment)
CONTRACT_ADDRESS=

# Frontend URL for CORS whitelist (use localhost:5173 for development)
FRONTEND_URL=http://localhost:5173

# Block number when the contract was deployed (from Etherscan or deploy output)
# Avoids querying from block 0 — Alchemy free tier limits to ~2000 blocks per query
CONTRACT_DEPLOY_BLOCK=
