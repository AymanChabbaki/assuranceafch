# ─── Blockchain / Hardhat Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# Sepolia RPC URL from Infura or Alchemy
# Example: https://sepolia.infura.io/v3/YOUR_PROJECT_ID
SEPOLIA_RPC_URL=

# Deployer wallet private key (without 0x prefix)
# WARNING: Use a dedicated deployment wallet — never your main wallet
# Prefer a Hardware Wallet or KMS in production
DEPLOYER_PRIVATE_KEY=

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=

# Set to "true" to enable gas usage reporting
REPORT_GAS=false
